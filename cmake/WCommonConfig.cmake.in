@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(fmt REQUIRED)
find_dependency(spdlog REQUIRED)

if(@WCOMMON_WITH_QT@)
  find_dependency(Qt6 REQUIRED COMPONENTS Core Gui Network)
endif()

# A component is found only if the package was built with it.
if("json" IN_LIST WCommon_FIND_COMPONENTS AND @WCOMMON_WITH_NLOHMANN@)
  find_dependency(nlohmann_json REQUIRED)
  if(@WCOMMON_WITH_QT@)
    find_dependency(Qt6 REQUIRED COMPONENTS Positioning)
  endif()
  set(WCommon_json_FOUND TRUE)
endif()

if("glaze" IN_LIST WCommon_FIND_COMPONENTS AND @WCOMMON_WITH_GLAZE@)
  find_dependency(glaze REQUIRED)
  if(@WCOMMON_WITH_QT@)
    find_dependency(Qt6 REQUIRED COMPONENTS Positioning)
  endif()
  set(WCommon_glaze_FOUND TRUE)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/WCommonTargets.cmake")

if(NOT TARGET @WCOMMON_TARGET_NAMESPACE@)
  add_library(@WCOMMON_TARGET_NAMESPACE@ ALIAS @WCOMMON_TARGET_NAMESPACE@::wcommon)
endif()

if(@WCOMMON_WITH_QT@)
  set_and_check(WCommon_METATYPES_FILE
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/metatypes/qt6wcommon_metatypes.json"
  )
  target_sources(@WCOMMON_TARGET_NAMESPACE@::wcommon INTERFACE
    "$<$<BOOL:$<TARGET_PROPERTY:QT_CONSUMES_METATYPES>>:${WCommon_METATYPES_FILE}>"
  )
endif()

# The C++ namespace the package was built in, and the include prefix of its headers.
set(WCommon_NAMESPACE "@WCOMMON_NAMESPACE@")
set(WCommon_INCLUDE_PREFIX "@WCOMMON_INCLUDE_PREFIX@")

check_required_components(WCommon)

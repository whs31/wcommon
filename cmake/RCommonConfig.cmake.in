@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(fmt REQUIRED)
find_dependency(spdlog REQUIRED)

if(@RCOMMON_WITH_QT@)
  find_dependency(Qt6 REQUIRED COMPONENTS Core Gui Network)
endif()

# A component is found only if the package was built with it.
if("json" IN_LIST RCommon_FIND_COMPONENTS AND @RCOMMON_WITH_NLOHMANN@)
  find_dependency(nlohmann_json REQUIRED)
  if(@RCOMMON_WITH_QT@)
    find_dependency(Qt6 REQUIRED COMPONENTS Positioning)
  endif()
  set(RCommon_json_FOUND TRUE)
endif()

if("glaze" IN_LIST RCommon_FIND_COMPONENTS AND @RCOMMON_WITH_GLAZE@)
  find_dependency(glaze REQUIRED)
  if(@RCOMMON_WITH_QT@)
    find_dependency(Qt6 REQUIRED COMPONENTS Positioning)
  endif()
  set(RCommon_glaze_FOUND TRUE)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/RCommonTargets.cmake")

if(NOT TARGET radar::mms::common)
  add_library(radar::mms::common ALIAS radar::mms::common::rcommon)
endif()

if(@RCOMMON_WITH_QT@)
  set_and_check(RCommon_METATYPES_FILE
    "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/metatypes/qt6rcommon_metatypes.json"
  )
  target_sources(radar::mms::common::rcommon INTERFACE
    "$<$<BOOL:$<TARGET_PROPERTY:QT_CONSUMES_METATYPES>>:${RCommon_METATYPES_FILE}>"
  )
endif()

check_required_components(RCommon)

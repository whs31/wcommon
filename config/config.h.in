#pragma once

// NOLINTBEGIN(cppcoreguidelines-macro-usage, readability-use-concise-preprocessor-directives)

#cmakedefine WHS31_COMMON_WITH_QT
#cmakedefine WHS31_COMMON_WITH_NLOHMANN
#cmakedefine WHS31_COMMON_WITH_GLAZE

#if defined(NDEBUG)
#  define WHS31_NO_DEBUG
#else
#  define WHS31_DEBUG
#endif

#if defined(WHS31_VERSION_ENCODE)
#  undef WHS31_VERSION_ENCODE
#endif
#define WHS31_VERSION_ENCODE(major,minor,patch) (((major) * 1000000) + ((minor) * 1000) + (patch))

#if defined(WHS31_VERSION_DECODE_MAJOR)
#  undef WHS31_VERSION_DECODE_MAJOR
#endif
#define WHS31_VERSION_DECODE_MAJOR(version) ((version) / 1000000)

#if defined(WHS31_VERSION_DECODE_MINOR)
#  undef WHS31_VERSION_DECODE_MINOR
#endif
#define WHS31_VERSION_DECODE_MINOR(version) (((version) % 1000000) / 1000)

#if defined(WHS31_VERSION_DECODE_PATCH)
#  undef WHS31_VERSION_DECODE_PATCH
#endif
#define WHS31_VERSION_DECODE_PATCH(version) ((version) % 1000)

#if defined(WHS31_STRINGIFY_EX)
#  undef WHS31_STRINGIFY_EX
#endif
#define WHS31_STRINGIFY_EX(x) #x

#if defined(WHS31_STRINGIFY)
#  undef WHS31_STRINGIFY
#endif
#define WHS31_STRINGIFY(x) WHS31_STRINGIFY_EX(x)

#if defined(WHS31_CONCAT_EX)
#  undef WHS31_CONCAT_EX
#endif
#define WHS31_CONCAT_EX(a,b) a##b

#if defined(WHS31_CONCAT)
#  undef WHS31_CONCAT
#endif
#define WHS31_CONCAT(a,b) WHS31_CONCAT_EX(a,b)

#if defined(WHS31_CONCAT3_EX)
#  undef WHS31_CONCAT3_EX
#endif
#define WHS31_CONCAT3_EX(a,b,c) a##b##c

#if defined(WHS31_CONCAT3)
#  undef WHS31_CONCAT3
#endif
#define WHS31_CONCAT3(a,b,c) WHS31_CONCAT3_EX(a,b,c)

#ifdef __cplusplus
#  define WHS31_C_DECL extern "C"
#  define WHS31_EXTERN_C_BEGIN extern "C" {
#  define WHS31_EXTERN_C_END }
#else
#  define WHS31_C_DECL
#  define WHS31_EXTERN_C_BEGIN
#  define WHS31_EXTERN_C_END
#endif

#define WHS31_C_FORWARD_DECLARE(TYPE) WHS31_EXTERN_C_BEGIN TYPE; WHS31_EXTERN_C_END

// NOLINTEND(cppcoreguidelines-macro-usage, readability-use-concise-preprocessor-directives)
